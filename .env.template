# ─────────────────────────────────────────────────────────────────────────────
# IIITA-Crypt — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get from: Atlas Dashboard → Cluster → Connect → Drivers → Node.js
# URL-encode special chars in password (e.g. # → %23)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>"

# JWT signing secret — use a strong random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Rule 1: CP-ABE Master Secret Key — MUST NOT be hardcoded
# Used by the Python encryption service (services/encryption/.env)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MSK=your_master_secret_key_here

# OpenAI API Key — used for text-embedding-3-small (vector search)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Groq API Key — used for llama-3.3-70b-versatile LLM synthesis
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Backend server port (default: 3000)
PORT=3000
